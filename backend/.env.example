# Copier en .env (cp .env.example .env). Toutes les variables sont facultatives en local.

# --- Django ---
DJANGO_DEBUG=1
DJANGO_SECRET_KEY=change-moi-en-production
# Hôtes supplémentaires séparés par des virgules (le nom Render est ajouté automatiquement)
DJANGO_ALLOWED_HOSTS=
# Origines autorisées pour les formulaires (le site Render et localhost:5173 sont ajoutés automatiquement)
CSRF_TRUSTED_ORIGINS=
# Base SQLite (par défaut backend/db.sqlite3 ; sur Render avec disque : /var/data/db.sqlite3)
SQLITE_PATH=

# --- Assistant IA (Claude) ---
# Sans clé, l'assistant répond depuis la FAQ intégrée (le site fonctionne quand même).
ANTHROPIC_API_KEY=
AI_MODEL=claude-haiku-5-5

# --- Liens de téléchargement (affichés sur le site, modifiables sans rebuild) ---
# APK : lien direct (EAS, GitHub Release...) OU déposer le fichier dans backend/downloads/airtrack.apk
APK_URL=
PLAY_STORE_URL=https://play.google.com/store/apps/details?id=com.airtrack.ci
APP_STORE_URL=

# --- Contact ---
SUPPORT_EMAIL=support@airtrack.ci
SUPPORT_WHATSAPP=

# --- E-mails (newsletter) : sans EMAIL_HOST, les e-mails s'affichent dans la console ---
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=AirTrack <newsletter@airtrack.ci>
# URL publique du site (liens de désinscription dans les e-mails)
PUBLIC_SITE_URL=http://localhost:5173
